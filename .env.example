# Copy to .env and fill in. Only VITE_* values are needed to run or build the
# site — they are public by design (Supabase RLS is what protects the data).
#
# Every secret (AI provider key, service role key, PayPal secret, Google service
# account, RESEND_API_KEY) lives in Supabase Edge Function secrets, never here:
#   supabase secrets set RESEND_API_KEY=... PAYPAL_CLIENT_SECRET=... etc.

VITE_SUPABASE_URL="https://gplszhhmothdbrqnpier.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="gplszhhmothdbrqnpier"

# Canonical site origin, used for canonical URLs and both sitemaps.
SITE_URL="https://agendax.co.il"

# "/" for a custom domain, "/<repo-name>/" for a github.io project site.
BASE_PATH="/"
